// Prisma schema for the Timesheet Platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  uploads         Upload[]
  generatedSheets GeneratedSheet[]
  documents       Document[]
}

// One row per file import (a whole workbook, which may contain multiple month tabs).
model Upload {
  id           String   @id @default(cuid())
  filename     String
  fileData     Bytes?
  uploadedAt   DateTime @default(now())
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String

  months UploadMonth[]
}

// One row per month tab processed within an upload (e.g. "MAY-25").
model UploadMonth {
  id          String   @id @default(cuid())
  month       String // normalized key, e.g. "2025-05"
  monthLabel  String // as it appeared in the sheet, e.g. "MAY-25"
  sheetName   String
  rowCount    Int      @default(0)
  processedAt DateTime @default(now())

  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String

  @@index([month])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  fullName  String? // formal letterhead name, e.g. "BURJ AL AWEER CONCRETE CARPENTER CONT."
  createdAt DateTime @default(now())

  mohrePermitNumber  String? // MOHRE manpower supply approval/permit number
  tradeLicenseNumber String?
  tradeLicenseExpiry DateTime?
  contactPerson      String?
  contactPhone       String?
  contactEmail       String?
  bankName           String?
  iban               String?
  paymentTerms       String? // e.g. "Net 30"
  status             String    @default("ACTIVE") // "ACTIVE" | "BLACKLISTED"

  entries         TimesheetEntry[]
  generatedSheets GeneratedSheet[]
  employees       Employee[]
}

model Client {
  id            String    @id @default(cuid())
  name          String    @unique
  code          String?   @unique
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  basicRate     Float?
  hourlyRate    Float?
  contractStart DateTime?
  contractEnd   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  trn                String? // Tax Registration Number
  tradeLicenseNumber String?
  tradeLicenseExpiry DateTime?
  billingAddress     String?
  paymentTerms       String? // e.g. "Net 30"
  retentionPercent   Float?
  secondContactName  String? // accounts payable contact, if different
  secondContactPhone String?
  secondContactEmail String?

  entries  TimesheetEntry[]
  projects Project[]
}

// One row per employee, per month, per supplier — upserted on re-upload so
// daily uploads simply refresh the running month's data.
model TimesheetEntry {
  id              String   @id @default(cuid())
  month           String // "2025-05"
  monthLabel      String // "MAY-25"
  employeeIdNo    String // e.g. "BACC123"
  employeeName    String
  trade           String
  rate            Float
  site            String?
  dailyHours      String // JSON: [{ "date": "2025-05-01", "label": "Thu", "value": "10" | "A" | "OFF" }, ...]
  totalHours      Float    @default(0)
  absentCount     Int      @default(0)
  absentDeduction Float    @default(0) // editable before export
  invoiceValue    Float    @default(0) // rate * totalHours, as in source sheet
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  @@unique([month, supplierId, employeeIdNo, trade])
  @@index([month, supplierId])
}

// A record of each generated company timesheet (for history / re-download).
model GeneratedSheet {
  id           String   @id @default(cuid())
  month        String
  monthLabel   String
  format       String // "xlsx" | "pdf"
  gasDeduction Float    @default(0)
  issuedTo     String
  generatedAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  generatedBy   User   @relation(fields: [generatedById], references: [id])
  generatedById String

  @@index([month, supplierId])
}

model Settings {
  id       String @id @default("singleton")
  issuedTo String @default("Kenz Al Turath Technical Services")
}

// Employee master record — auto-created/refreshed from uploads (name, trade,
// supplier) and manually enriched here (photo, compliance dates, etc). The
// upload flow never touches the manually-owned fields.
model Employee {
  id              String    @id @default(cuid())
  employeeIdNo    String    @unique
  name            String
  trade           String?
  photoData       Bytes?
  photoMimeType   String?
  nationality     String?
  position        String?
  passportNumber  String?
  emiratesId      String?
  visaExpiry      DateTime?
  laborCardExpiry DateTime?
  medicalExpiry   DateTime?
  passportExpiry  DateTime?
  salaryType      String? // "BASIC" | "HOURLY" — reference only
  notes           String?

  dateOfBirth           DateTime?
  gender                String? // "MALE" | "FEMALE"
  bloodGroup            String?
  mobileNumber          String?
  whatsappNumber        String?
  joinDate              DateTime?
  laborCardNumber       String?
  sponsorName           String? // visa-holding entity, if different from supplier
  emergencyContactName  String?
  emergencyContactPhone String?
  wpsBankName           String? // Wage Protection System bank / exchange house
  wpsIban               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  documents Document[]
  skills    EmployeeSkill[]
  bed       Bed?
}

model Document {
  id         String    @id @default(cuid())
  type       String // "PASSPORT" | "VISA" | "LABOR_CARD" | "MEDICAL" | "OTHER"
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

model Project {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  description   String?
  manager       String?
  timelineStart DateTime?
  timelineEnd   DateTime?
  status        String    @default("PLANNING") // "PLANNING" | "ACTIVE" | "COMPLETED" | "ON_HOLD"
  createdAt     DateTime  @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  site   Site?   @relation(fields: [siteId], references: [id])
  siteId String?

  employees Employee[]
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  trending Boolean @default(false)

  employees EmployeeSkill[]
}

model EmployeeSkill {
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String

  @@id([employeeId, skillId])
}

model Camp {
  id    String @id @default(cuid())
  name  String @unique
  rooms Room[]
}

model Site {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
}

model Room {
  id     String @id @default(cuid())
  name   String
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String
  beds   Bed[]

  @@unique([campId, name])
}

model Bed {
  id     String @id @default(cuid())
  label  String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  @@unique([roomId, label])
}
