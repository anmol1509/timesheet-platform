// Prisma schema for the Timesheet Platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // cross-branch; replaces the old global ADMIN
  BRANCH_ADMIN // full admin rights, scoped to one branch
  STAFF
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  emirate   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Company master-data fields (address/contact details of this operating entity).
  address  String?
  country  String?
  currency String?
  phone    String?
  email    String?
  // Letterhead details printed on generated timesheets and invoices.
  fax      String?
  poBox    String?
  trn      String? // Tax Registration Number

  // Company logo, shown in the sidebar and on generated letterheads.
  logo   StoredImage? @relation("BranchLogo", fields: [logoId], references: [id], onDelete: SetNull)
  logoId String?

  // Letter defaults (Company profile -> Letters). All optional; using them is chosen per letter.
  signatoryName     String?
  signatoryTitle    String?
  signature         StoredImage? @relation("BranchSignature", fields: [signatureId], references: [id], onDelete: SetNull)
  signatureId       String?
  stamp             StoredImage? @relation("BranchStamp", fields: [stampId], references: [id], onDelete: SetNull)
  stampId           String?
  // Full-page letterhead artwork (A4) used when printing letters "on letterhead".
  letterheadImage   StoredImage? @relation("BranchLetterhead", fields: [letterheadImageId], references: [id], onDelete: SetNull)
  letterheadImageId String?

  // WPS establishment details (Company profile -> Payroll / WPS).
  wpsEstablishmentId       String? // MOHRE establishment / employer ID
  wpsPayerBank             Bank?               @relation("BranchWpsPayerBank", fields: [wpsPayerBankId], references: [id], onDelete: SetNull)
  wpsPayerBankId           String?
  // A payroll run above this total (AED) can't be approved by the person who created it.
  payrollApprovalThreshold Decimal?            @db.Decimal(14, 2)
  // Above this, an expense needs an admin to approve it (STAFF approvers are capped).
  expenseApprovalLimit     Decimal?            @db.Decimal(14, 2)
  expenseBudgets           ExpenseBudget[]
  pettyCashTopUps          PettyCashTopUp[]
  portalContacts           PortalContact[]
  payrollRuns              PayrollRun[]
  employeeLoans            EmployeeLoan[]
  payrollAdjustments       PayrollAdjustment[]

  expenses        Expense[]
  issuedLetters   IssuedLetter[]
  supplierBills   SupplierBill[]
  accessRoles     AccessRole[]
  users           User[]
  employees       Employee[]
  clients         Client[]
  suppliers       Supplier[]
  projects        Project[]
  uploads         Upload[]
  invoices        ClientInvoice[]
  sheets          GeneratedSheet[]
  items           InventoryItem[]
  entries         TimesheetEntry[]
  banks           Bank[]
  lookupValues    LookupValue[]
  demandRequests  DemandRequest[]
  letterTemplates LetterTemplate[]
  nocs            Noc[]
  lpos            Lpo[]
  attendance      Attendance[]
  enquiries       Enquiry[]
  quotations      Quotation[]
}

// Company bank-account master, needed before Payroll/WPS can pay from a
// real account.
model Bank {
  id           String  @id @default(cuid())
  accountName  String
  bankName     String
  abbreviation String?
  accountNo    String?
  ibanNo       String?
  routingCode  String?
  swiftCode    String?
  bankBranch   String? // the bank's own branch name, not our Branch model
  address      String?
  remarks      String?
  // "ACTIVE" here only means "not switched off". Whether a bank is usable is
  // decided by lib/bankStatus.ts from the details below, so a bank with no
  // account number can never present itself as active.
  status       String  @default("ACTIVE")

  accountType   String? // "CURRENT" | "SAVINGS" | "CREDIT" | "OTHER"
  currency      String  @default("AED")
  contactPerson String? // the relationship manager at the bank
  contactPhone  String?
  contactEmail  String?

  // Which of our own companies holds this account, so each company's payroll
  // can pay from its own account.
  company   Supplier? @relation("CompanyBanks", fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  wpsForBranches Branch[]     @relation("BranchWpsPayerBank")
  payrollRuns    PayrollRun[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  // Profile. `isActive` lets an admin suspend a sub-user without deleting
  // them (deleting fails anyway once they own uploads/documents).
  phone          String?
  jobTitle       String?
  isActive       Boolean        @default(true)
  // Delivery preferences for notifications (in-app always on).
  notifyEmail    Boolean        @default(true)
  notifyWhatsapp Boolean        @default(false)
  whatsappNumber String?
  notifications  Notification[]
  avatar         StoredImage?   @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  avatarId       String?

  // Fine-grained permissions. Null = legacy behaviour driven by `role` alone
  // (admins do everything, STAFF everything except Administration), so every
  // pre-existing user keeps working unchanged.
  accessRole   AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: SetNull)
  accessRoleId String?

  // SUPER_ADMIN is not tied to one branch, so this stays nullable.
  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  uploads          Upload[]
  generatedSheets  GeneratedSheet[]
  documents        Document[]
  clientInvoices   ClientInvoice[]
  clientDocuments  ClientDocument[]
  projectDocuments ProjectDocument[]
  attachments      Attachment[]
  demandRequests   DemandRequest[]
  nocs             Noc[]
  employeeNotes    EmployeeNote[]

  dashboardPreference DashboardPreference?
  lettersIssued       IssuedLetter[]
  expensesSubmitted   Expense[]            @relation("ExpenseSubmittedBy")
  expensesDecided     Expense[]            @relation("ExpenseDecidedBy")
  payrollCreated      PayrollRun[]         @relation("PayrollCreatedBy")
  payrollApproved     PayrollRun[]         @relation("PayrollApprovedBy")
}

// Small uploaded images (user avatars, company logos). Its own table so the
// bytes are never dragged along by `include: { branch: true }` / user reads.
model StoredImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  updatedAt DateTime @default(now()) @updatedAt

  userAvatars       User[]   @relation("UserAvatar")
  branchLogos       Branch[] @relation("BranchLogo")
  branchSignatures  Branch[] @relation("BranchSignature")
  branchStamps      Branch[] @relation("BranchStamp")
  branchLetterheads Branch[] @relation("BranchLetterhead")
}

// A named bundle of "module:action" permission keys (see src/lib/permissions.ts)
// that can be assigned to any number of sub-users. branchId null = available
// to every branch (created by a super admin).
model AccessRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String?
  users    User[]

  @@unique([branchId, name])
}

// Per-user show/hide + order for the main dashboard's widgets. Widget ids are
// defined in src/lib/dashboardWidgets.ts, not enforced at the DB level — an
// id that no longer exists (a widget removed later) is just ignored at render
// time rather than migrated, and a widget added later simply isn't in
// `widgetOrder` yet, so it falls back to appending after the known ones.
model DashboardPreference {
  id            String   @id @default(cuid())
  hiddenWidgets String[] @default([])
  widgetOrder   String[] @default([])
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// One row per file import (a whole workbook, which may contain multiple month tabs).
model Upload {
  id           String   @id @default(cuid())
  filename     String
  fileData     Bytes?
  uploadedAt   DateTime @default(now())
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  months UploadMonth[]
}

// One row per month tab processed within an upload (e.g. "MAY-25").
model UploadMonth {
  id          String   @id @default(cuid())
  month       String // normalized key, e.g. "2025-05"
  monthLabel  String // as it appeared in the sheet, e.g. "MAY-25"
  sheetName   String
  rowCount    Int      @default(0)
  processedAt DateTime @default(now())

  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String

  @@index([month])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  fullName  String? // formal letterhead name, e.g. "BURJ AL AWEER CONCRETE CARPENTER CONT."
  createdAt DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  mohrePermitNumber   String? // MOHRE manpower supply approval/permit number
  tradeLicenseNumber  String?
  tradeLicenseExpiry  DateTime?
  contactPerson       String?
  contactPhone        String?
  contactEmail        String?
  bankName            String?
  iban                String?
  paymentTerms        String? // e.g. "Net 30"
  status              String    @default("ACTIVE") // "ACTIVE" | "BLACKLISTED"
  payoutCycleStartDay Int       @default(1) // day of month the payout cycle starts; 1 = calendar month

  category            String?
  previousId          String?
  allowManualLabourId Boolean @default(false)
  overtime            Boolean @default(false)
  supplierAmountLimit Float? // credit limit
  pointOfContact      String?
  country             String?
  emirate             String?
  account             String? // accounting reference only, no ledger integration
  bankAccountName     String?
  bankAccountNumber   String?
  bankCompany         String? // beneficiary company name on the bank account
  bankEmirate         String?

  trn        String? // Tax Registration Number
  activeFrom DateTime?
  poBox      String?
  location   String?
  phone      String? // secondary phone, distinct from contactPhone (mobile)

  approvalStatus        String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates attaching labour to a project
  labourApprovalStatus  String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates allocating labour to a Demand Request
  invoiceApprovalStatus String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates generating the supplier payout sheet

  // Our own entities vs third-party subcontractors. Same shape, but the
  // distinction drives whose letterhead a document is issued on and who is
  // being billed rather than paid.
  isOwnCompany Boolean @default(false)

  // The point of contact this supplier's workers' camp check-in slips are
  // printed with — distinct from contactPerson (the general business
  // contact), since the accommodation coordinator is often a different
  // person on the supplier's side.
  coordinatorName  String?
  coordinatorPhone String?
  coordinatorEmail String?

  sponsoredEmployees Employee[] @relation("EmployeeSponsor")

  parent           Supplier?  @relation("SupplierSubsidiaries", fields: [parentSupplierId], references: [id])
  parentSupplierId String?
  subsidiaries     Supplier[] @relation("SupplierSubsidiaries")

  ownedCamps Camp[] @relation("CampOwner")

  entries         TimesheetEntry[]
  generatedSheets GeneratedSheet[]
  employees       Employee[]
  attendance      Attendance[]

  // Supplier portal sign-in (phone + one-time code, matched against the contact,
  // secondary and coordinator numbers). Off by default: an admin opts each
  // supplier in.
  demandOffers      DemandSupplierOffer[]
  workerSubmissions WorkerSubmission[]
  availability      SupplierAvailability[]
  changeRequests    SupplierChangeRequest[]
  tickets           SupplierTicket[]
  banks             Bank[]                  @relation("CompanyBanks")
  payrollRuns       PayrollRun[]            @relation("PayrollCompany")

  // Own companies only: how this company pays its people, and its own MOHRE
  // establishment id for the WPS file. Every employee of a company is paid the
  // same way: "BASIC" (monthly salary, adjusted from attendance) or "HOURLY"
  // (hours taken from the timesheet).
  payType            String? // "BASIC" | "HOURLY"
  wpsEstablishmentId String?
  notifications      SupplierNotification[]
  portalEnabled      Boolean                @default(false)
  bills              SupplierBill[]
}

model Client {
  id            String    @id @default(cuid())
  name          String    @unique
  code          String?   @unique
  branch        Branch    @relation(fields: [branchId], references: [id])
  branchId      String
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  basicRate     Float?
  hourlyRate    Float?
  contractStart DateTime?
  contractEnd   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  trn                String? // Tax Registration Number
  tradeLicenseNumber String?
  tradeLicenseExpiry DateTime?
  billingAddress     String?
  paymentTerms       String? // e.g. "Net 30"
  retentionPercent   Float?
  secondContactName  String? // accounts payable contact, if different
  secondContactPhone String?
  secondContactEmail String?

  country         String?
  emirate         String?
  website         String?
  fax             String?
  poBox           String?
  paymentSchedule String?
  account         String? // accounting reference only, no ledger integration
  vendorCode      String?

  customer  String? // parent/umbrella account, if applicable
  currency  String? @default("AED")
  grades    String?
  telephone String? // landline, distinct from contactPhone (mobile)

  entries        TimesheetEntry[]
  projects       Project[]
  contacts       ClientContact[]
  invoices       ClientInvoice[]
  tradeRates     ClientTradeRate[]
  documents      ClientDocument[]
  demandRequests DemandRequest[]
  lpos           Lpo[]
  enquiries      Enquiry[]
  quotations     Quotation[]
}

// Per-trade billing rate for a client, e.g. Carpenter AED 45/hr, Helper AED 35/hr.
// Falls back to Client.hourlyRate/basicRate when a trade has no rate set here.
// A row with projectId set overrides the client-wide row for that trade on that project.
model ClientTradeRate {
  id    String @id @default(cuid())
  trade String
  rate  Float

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  @@unique([clientId, projectId, trade])
}

model ClientDocument {
  id         String    @id @default(cuid())
  type       String // "TRADE_LICENSE" | "TRN_CERTIFICATE" | "CONTRACT" | "OTHER"
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

// A record of each generated client invoice (for history / re-download / AR tracking).
model ClientInvoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  month         String
  monthLabel    String
  subtotal      Float
  vatAmount     Float
  totalAmount   Float
  status        String    @default("DRAFT") // "DRAFT" | "SENT" | "PAID" | "OVERDUE"
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  paidDate      DateTime?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  generatedBy   User   @relation(fields: [generatedById], references: [id])
  generatedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([month, clientId])
}

model ClientContact {
  id          String  @id @default(cuid())
  name        String
  designation String?
  phone       String?
  email       String?

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
}

// One row per employee, per month, per supplier — upserted on re-upload so
// daily uploads simply refresh the running month's data.
model TimesheetEntry {
  id              String   @id @default(cuid())
  month           String // "2025-05"
  monthLabel      String // "MAY-25"
  employeeIdNo    String // e.g. "BACC123"
  employeeName    String
  trade           String
  rate            Float
  site            String?
  dailyHours      String // JSON: [{ "date": "2025-05-01", "label": "Thu", "value": "10" | "A" | "OFF" }, ...]
  totalHours      Float    @default(0)
  absentCount     Int      @default(0)
  absentDeduction Float    @default(0) // editable before export
  invoiceValue    Float    @default(0) // rate * totalHours, as in source sheet
  status          String   @default("DRAFT") // "DRAFT" | "SUBMITTED" | "UNDER_REVIEW" | "CLIENT_APPROVED" | "REJECTED" | "LOCKED"
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  // Denormalized directly rather than derived through supplier/client, since
  // this is the highest-volume table and list queries need a join-free filter.
  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  // Set only via manual entry today; Excel-upload entries have no project info
  // and fall back to the client-level billing rate when generating invoices.
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // `site` (above) is the legacy free-text column, still populated by Excel
  // imports independently — this FK is the new optional link to a real Site
  // record, set only by Daily Timesheet / Manual Entry when one is picked.
  siteRecord Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId     String?

  @@unique([month, supplierId, employeeIdNo, trade])
  @@index([month, supplierId])
  @@index([branchId])
}

// A record of each generated company timesheet (for history / re-download).
model GeneratedSheet {
  id           String   @id @default(cuid())
  month        String
  monthLabel   String
  format       String // "xlsx" | "pdf"
  gasDeduction Float    @default(0)
  issuedTo     String
  generatedAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  generatedBy   User   @relation(fields: [generatedById], references: [id])
  generatedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([month, supplierId])
}

model Settings {
  id         String  @id @default("singleton")
  issuedTo   String  @default("Kenz Al Turath Technical Services")
  companyTrn String? // this company's own Tax Registration Number, printed on client invoices
}

enum EmployeeStatus {
  // On the books, not working.
  IDLE
  // Allocated to a demand on paper, but nobody has confirmed they turned up.
  UNDER_MOBILISATION
  // Someone has confirmed the worker physically reached site. Distinct from
  // ACTIVE because arrival is a fact a supervisor asserts on the day, while
  // attendance is only entered later — often days later, sometimes never.
  ON_SITE
  // Working: attendance has been marked at least once since mobilising.
  ACTIVE
  ON_VACATION
  TERMINATED
}

enum EmployeeCategory {
  STAFF // office/corporate roster
  SITE_STAFF // field/manpower roster
}

// Employee master record — auto-created/refreshed from uploads (name, trade,
// supplier) and manually enriched here (photo, compliance dates, etc). The
// upload flow never touches the manually-owned fields.
model Employee {
  id                 String              @id @default(cuid())
  // Pay structure for payroll. ITEMISED = basic + allowances; FLAT = one
  // monthly rate; HOURLY = normal hours x hourly rate. Overtime is paid on top,
  // at (basic|flat)/240 x multiplier, or hourly rate x multiplier for HOURLY.
  payStructure       String? // "ITEMISED" | "FLAT" | "HOURLY"
  basicSalary        Decimal?            @db.Decimal(12, 2)
  housingAllowance   Decimal?            @db.Decimal(12, 2)
  foodAllowance      Decimal?            @db.Decimal(12, 2)
  transportAllowance Decimal?            @db.Decimal(12, 2)
  otherAllowance     Decimal?            @db.Decimal(12, 2)
  flatMonthlyRate    Decimal?            @db.Decimal(12, 2)
  hourlyRate         Decimal?            @db.Decimal(12, 2)
  paysOvertime       Boolean             @default(true)
  otMultiplier       Decimal             @default(1.25) @db.Decimal(4, 2)
  payrollLines       PayrollLine[]
  loans              EmployeeLoan[]
  payAdjustments     PayrollAdjustment[]
  issuedLetters      IssuedLetter[]
  // Self-service portal sign-in (phone + one-time code). On by default; an admin
  // can switch it off per employee.
  essEnabled         Boolean             @default(true)
  employeeIdNo       String              @unique
  name               String
  trade              String?
  // Kept alongside the legacy `active` boolean during the transition — existing
  // dashboard/list queries still read `active`; new code should prefer `status`.
  status             EmployeeStatus      @default(ACTIVE)
  category           EmployeeCategory    @default(SITE_STAFF)
  photoData          Bytes?
  photoMimeType      String?
  nationality        String?
  position           String?
  passportNumber     String?
  emiratesId         String?
  emiratesIdExpiry   DateTime?
  visaExpiry         DateTime?
  laborCardExpiry    DateTime?
  medicalExpiry      DateTime?
  passportExpiry     DateTime?
  salaryType         String? // "BASIC" | "HOURLY" — reference only
  salaryRate         Float? // reference only, pairs with salaryType
  notes              String?

  dateOfBirth           DateTime?
  gender                String? // "MALE" | "FEMALE"
  bloodGroup            String?
  mobileNumber          String?
  whatsappNumber        String?
  joinDate              DateTime?
  laborCardNumber       String?
  sponsorName           String? // visa-holding entity, if different from supplier
  emergencyContactName  String?
  emergencyContactPhone String?
  wpsBankName           String? // Wage Protection System bank / exchange house
  wpsIban               String?
  wpsPaymentMode        String?
  wpsRoutingCode        String?
  wpsAccountHolderName  String?
  wpsAccountNumber      String?

  // Visa (visaExpiry above is the terminal expiry date already tracked)
  // ICP unified number — stable across visa renewals, unlike the file number.
  unifiedNo        String?
  visaNumber       String?
  visaType         String?
  visaStatus       String?
  visaDesignation  String?
  visaStampingDate DateTime?
  molPersonCode    String?

  // Passport (passportNumber/passportExpiry above already exist)
  passportStatus      String?
  passportReleaseDate DateTime?
  passportReturnDate  DateTime?

  // Labour Card (laborCardNumber/laborCardExpiry above already exist)
  laborCardPersonalNo String?
  laborCardStatus     String?

  // CICPA — Abu Dhabi critical-infrastructure/coastal-protection site clearance
  cicpaNumber    String?
  cicpaIssueDate DateTime?
  cicpaExpiry    DateTime?
  cicpaStatus    String?
  cicpaLocation  String?

  // Insurance
  insuranceCardType        String?
  insuranceCardNumber      String?
  insuranceIssueDate       DateTime?
  insuranceExpiry          DateTime?
  insuranceStatus          String?
  insuranceServiceProvider String?

  // Driving Licence
  drivingLicenceNumber    String?
  drivingLicenceIssueDate DateTime?
  drivingLicenceExpiry    DateTime?
  drivingLicenceType      String?
  drivingLicenceStatus    String?

  // Medical (medicalExpiry above already exists)
  medicalStatus String?
  eidStatus     String?

  active              Boolean   @default(true)
  inactiveReason      String?
  lastDemobilizedDate DateTime?
  // The date the worker is due on site, chosen when mobilising. Distinct from
  // the assignment's created date, which is when the paperwork was done.
  mobilisationDate    DateTime?
  // The date the worker was confirmed to have actually reached site. Null while
  // they are still only mobilised on paper; the gap between the two dates is
  // how late a mobilisation ran.
  siteArrivalDate     DateTime?
  religion            String?
  state               String? // state/province within nationality country
  accommodationType   String?
  previousId          String?
  nameInIdCard        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  // The company holding the visa. Often, but not always, the employer, so it
  // stays a separate link — it just points at Supplier now rather than a
  // duplicate SponsorshipCompany list.
  sponsorSupplier   Supplier? @relation("EmployeeSponsor", fields: [sponsorSupplierId], references: [id])
  sponsorSupplierId String?

  documents                Document[]
  skills                   EmployeeSkill[]
  vaccinations             EmployeeVaccination[]
  visaApplications         VisaApplication[]
  labourCardApplications   LabourCardApplication[]
  noteEntries              EmployeeNote[]
  assignmentHistory        EmployeeAssignmentHistory[]
  accommodationHistory     AccommodationHistory[]
  demandRequestAllocations DemandRequestAllocation[]
  nocEmployees             NocEmployee[]
  bed                      Bed?
  campCheckIns             CampCheckIn[]
  attendance               Attendance[]
  inventoryAssignments     EmployeeInventoryAssignment[]
}

// System-written record of each project placement — opened/closed
// automatically by updateEmployeeAction when Employee.projectId changes.
// Employee.projectId remains the live pointer; this is the audit trail of
// past placements, since there's no other way to know when someone was
// mobilized/demobilized to a given project.
// A dated note about a worker with its own attachments — prior employment,
// a warning, a site incident, anything worth keeping on file. Repeatable, so
// the record builds up over time instead of one field being overwritten.
model EmployeeNote {
  id        String   @id @default(cuid())
  remarks   String
  createdAt DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  documents Document[]

  @@index([employeeId, createdAt])
}

model EmployeeAssignmentHistory {
  id              String    @id @default(cuid())
  branchName      String? // snapshot; branchId isn't the change trigger here
  projectId       String?
  projectName     String? // snapshot — stays readable if the Project is later renamed/deleted
  mobilizedDate   DateTime  @default(now())
  demobilizedDate DateTime?
  createdAt       DateTime  @default(now())

  // Why the placement ended, and who ended it. This row is already the record
  // of the placement, so the reason belongs on it rather than only in the audit
  // log — the demobilisation list reads it back.
  demobilizationReason String?
  demobilizedByName    String? // snapshot, like branchName/projectName above

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@index([employeeId])
  @@index([demobilizedDate])
}

// System-written record of each bed placement — opened/closed automatically
// by assignBedAction/unassignBedAction. Bed.employeeId remains the live
// pointer; this is the audit trail, using string snapshots (not FKs) so
// history stays readable even after a bed/room/camp is later deleted.
model AccommodationHistory {
  id           String    @id @default(cuid())
  campName     String?
  roomName     String?
  bedLabel     String?
  checkInDate  DateTime  @default(now())
  checkOutDate DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@index([employeeId])
}

// Stage-tracking history for a visa cycle (submitted -> medical -> stamped ->
// cancelled -> re-issued, etc). Employee.visaNumber/visaStatus/visaExpiry
// remain the compliance/dashboard source of truth (the current snapshot);
// this is a pure audit trail of how that snapshot got there over time.
model VisaApplication {
  id        String    @id @default(cuid())
  stage     String // LookupValue category VISA_APPLICATION_STAGE
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
}

// Same shape as VisaApplication, for labour card stage history.
model LabourCardApplication {
  id        String    @id @default(cuid())
  stage     String // LookupValue category LABOUR_CARD_APPLICATION_STAGE
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
}

// Repeatable vaccination record per employee (from the competitor's Medical
// Details tab).
model EmployeeVaccination {
  id          String    @id @default(cuid())
  vaccineName String
  doseNumber  Int?
  date        DateTime?
  expiryDate  DateTime?
  notes       String?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
}

model Document {
  id           String    @id @default(cuid())
  type         String // "PASSPORT" | "VISA" | "LABOR_CARD" | "MEDICAL" | "EMIRATES_ID" | "CICPA" | "INSURANCE" | "DRIVING_LICENCE" | "OTHER"
  status       String    @default("ACTIVE")
  displayInEss Boolean   @default(false)
  filename     String
  fileData     Bytes
  mimeType     String
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  uploadedById String
  // Set when the file was attached to a note rather than filed on its own.
  note         EmployeeNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId       String?

  visaApplications       VisaApplication[]
  labourCardApplications LabourCardApplication[]
}

model Project {
  id            String    @id @default(cuid())
  expenses      Expense[]
  code          String    @unique
  name          String
  description   String?
  manager       String?
  timelineStart DateTime?
  timelineEnd   DateTime?
  status        String    @default("PLANNING") // "PLANNING" | "ACTIVE" | "COMPLETED" | "ON_HOLD"
  createdAt     DateTime  @default(now())

  clientProjectNo         String? // client's own reference/PO number
  jobType                 String?
  mainContractor          String?
  paymentType             String?
  sponsorshipCompany      String?
  salesExecutive          String?
  salesExecutivePhone     String?
  salesExecutiveEmail     String?
  projectCoordinator      String?
  projectCoordinatorPhone String?
  projectCoordinatorEmail String?
  managerPhone            String?
  managerEmail            String?
  contactNo               String?
  timesheetCollectionDate DateTime?
  noOfEmployeesRequired   Int?
  dayShiftStart           String? // "HH:MM"
  dayShiftEnd             String?
  nightShiftStart         String?
  nightShiftEnd           String?
  interTransfer           Boolean   @default(false)
  internalUse             Boolean   @default(false)

  address   String? // free-text location detail
  latitude  Float?
  longitude Float?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  employees        Employee[]
  vehicles         VehicleProject[]
  timesheetEntries TimesheetEntry[]
  tradeRates       ClientTradeRate[]
  documents        ProjectDocument[]
  holidays         ProjectHoliday[]
  contacts         ProjectContact[]
  inventory        ProjectInventoryAssignment[]
  demandRequests   DemandRequest[]
  routes           Route[]
  sites            Site[]
  lpos             Lpo[]
  attendance       Attendance[]
  quotations       Quotation[]
}

// A Local Purchase Order — the client's authorization + funding envelope for
// a Project. A Project can have more than one Lpo over its lifetime (renewal
// / amendment); only one is normally ACTIVE at a time, tracked via status
// rather than enforced by the schema (matches this codebase's convention of
// plain-string statuses with no state-machine helper). billedAmount is a
// manually-tracked running total, not derived from ClientInvoice, because
// ClientInvoice is client+month scoped today with no project/LPO linkage.
model Lpo {
  id           String    @id @default(cuid())
  lpoNumber    String    @unique
  value        Float?
  quantity     Int?
  trade        String?
  rate         Float?
  validFrom    DateTime?
  validTo      DateTime?
  status       String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CLOSED"
  billedAmount Float     @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([branchId, projectId])
}

// Daily attendance, distinct from the monthly TimesheetEntry hours grid —
// one row per employee per calendar day. Once approved (locked=true),
// direct edits are rejected and any change must go through
// AttendanceCorrectionRequest instead. Deliberately not wired into
// TimesheetEntry.dailyHours yet — that JSON pipeline has too many existing
// consumers (Excel import, xlsx/pdf export, gas-deduction calc) to safely
// rewire in this pass; a later phase can add a reconcile step once this
// module has run in production long enough to trust its data.
model Attendance {
  id           String    @id @default(cuid())
  date         DateTime
  status       String    @default("PRESENT") // "PRESENT" | "ABSENT" | "LEAVE" | "HOLIDAY" | "OFF"
  normalHours  Float?
  otHours      Float?
  locked       Boolean   @default(false)
  markedById   String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  corrections AttendanceCorrectionRequest[]

  @@unique([employeeId, date])
  @@index([branchId, date])
  @@index([projectId, date])
}

model AttendanceCorrectionRequest {
  id                   String    @id @default(cuid())
  requestedStatus      String?
  requestedNormalHours Float?
  requestedOtHours     Float?
  reason               String?
  status               String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  requestedById        String
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId String
}

// Pre-sales pipeline: Client Enquiry/RFQ, ahead of a Quotation. No Project
// exists yet at this stage (projectHint is free text only).
model Enquiry {
  id            String   @id @default(cuid())
  enquiryNo     Int      @unique @default(autoincrement())
  projectHint   String?
  requiredTrade String?
  source        String?
  remarks       String?
  status        String   @default("Open") // "Open" | "Quoted" | "Lost" | "Converted"
  createdAt     DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  requestedById String?

  quotations Quotation[]
}

// A formal quotation with trade/quantity/rate line items, moving through
// negotiation/approval stages before conversion into a real Project (and
// optionally an Lpo, if Phase A's Lpo model is populated at conversion
// time). Mirrors the DemandRequest/DemandRequestTrade header+line shape.
model Quotation {
  id                           String    @id @default(cuid())
  quotationNumber              String    @unique
  status                       String    @default("DRAFT") // "DRAFT" | "SENT" | "NEGOTIATION" | "APPROVED" | "ACCEPTED" | "REJECTED" | "CONVERTED"
  validUntil                   DateTime?
  terms                        String?
  accommodationResponsibility  String?
  transportationResponsibility String?
  ppeResponsibility            String?
  createdAt                    DateTime  @default(now())

  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id])
  enquiryId String?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String? // set once converted

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  createdById String

  lines QuotationLine[]
}

model QuotationLine {
  id           String  @id @default(cuid())
  trade        String
  quantity     Int
  rate         Float
  otRate       Float?
  nationality  String?
  workingHours String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
}

// A physical location under a Project — one Project can have multiple Sites
// (e.g. separate buildings/plots on one job). Deliberately a child of
// Project, not a standalone concept (the earlier flat, unrelated Site model
// was removed for exactly that reason).
model Site {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  employees        Employee[]
  timesheetEntries TimesheetEntry[]
}

model ProjectDocument {
  id         String    @id @default(cuid())
  type       String // "CONTRACT" | "LPO" | "PERMIT" | "OTHER"
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

model ProjectHoliday {
  id             String   @id @default(cuid())
  date           DateTime
  label          String
  rateMultiplier Float? // e.g. 1.5 for 1.5x pay on this date

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([projectId, date])
}

// Free-text roster of people tied to a project (not a login/User account).
model ProjectContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  phone String?
  email String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model InventoryItem {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  notes    String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  assignments         ProjectInventoryAssignment[]
  employeeAssignments EmployeeInventoryAssignment[]
  variants            InventoryVariant[]
}

// A distinct purchasable/issuable option of an item — size, colour, or any
// other distinguishing attribute the item is stocked in (e.g. "Size 42",
// "Red - Large"). Stock is tracked per variant, not on the item itself, once
// an item has any variants; an item with none is issued directly (variantId
// left null on the assignment), unchanged from before variants existed.
model InventoryVariant {
  id    String  @id @default(cuid())
  name  String
  sku   String?
  // Units on hand. "Available" (stock minus currently-held, unreturned
  // assignments) is computed on read, not stored, so it can never drift out
  // of sync the way a decrement-on-issue/increment-on-return counter could.
  stock Int     @default(0)

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  assignments EmployeeInventoryAssignment[]

  @@unique([itemId, name])
}

model ProjectInventoryAssignment {
  id           String    @id @default(cuid())
  quantity     Int       @default(1)
  assignedDate DateTime  @default(now())
  returnDate   DateTime?
  condition    String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  item   InventoryItem @relation(fields: [itemId], references: [id])
  itemId String
}

// One row per unit (or batch of units) of an inventory item handed to a
// worker — PPE most often, but not exclusive to it. Kept separate from
// ProjectInventoryAssignment (which tracks item-to-project, not item-to-person)
// so the same item can be tracked issued to a site AND to individuals without
// overloading one join table's meaning. returnDate null means still held —
// that's what lets an admin see a worker is still carrying last quarter's
// harness before issuing another.
model EmployeeInventoryAssignment {
  id         String    @id @default(cuid())
  quantity   Int       @default(1)
  issuedDate DateTime  @default(now())
  returnDate DateTime?
  condition  String?
  notes      String?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  item   InventoryItem @relation(fields: [itemId], references: [id])
  itemId String

  // Which specific variant was issued, when the item has any. Null for an
  // item with no variants (issued directly, as before variants existed).
  variant   InventoryVariant? @relation(fields: [variantId], references: [id])
  variantId String?

  @@index([employeeId])
  @@index([itemId])
  @@index([variantId])
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  // Short mnemonic (HLP, MSN, SFX) printed on timesheets and letters, where a
  // full trade name doesn't fit a column.
  code     String? @unique
  category String?
  trending Boolean @default(false)

  employees    EmployeeSkill[]
  demandTrades DemandRequestTrade[]
}

model EmployeeSkill {
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String

  // "Known Trade Details" — proficiency and a trade-specific pay rate.
  proficiencyPercent Int?
  rate               Float?
  // "HOURLY" | "FIXED" — how `rate` is applied for this trade.
  rateType           String?
  // The trade the worker is currently deployed as. A worker can hold several
  // trades but works one at a time, and it's the active one that a demand
  // matches against and that the timesheet bills.
  isActive           Boolean @default(false)

  @@id([employeeId, skillId])
}

model Camp {
  id    String @id @default(cuid())
  name  String @unique
  rooms Room[]

  // Whether this camp is run by the company itself or by a manpower
  // supplier — printed as "Camp Type" on the check-in slip.
  ownerType String @default("OWN") // "OWN" | "SUPPLIER"

  owningSupplier   Supplier? @relation("CampOwner", fields: [owningSupplierId], references: [id])
  owningSupplierId String?

  checkIns CampCheckIn[]
}

// A worker's placement into a camp, ahead of a specific room/bed — the first
// of the two-stage check-in flow (Create Check-In, then Bed Allocation).
// checkInNo is a human-facing sequence printed on the check-in slip PDF.
// Bed.employeeId stays the authoritative "who's actually in this bed"
// pointer used everywhere else (Employee profile, camp occupancy, dashboard);
// bedId here just tracks which allocation this check-in resulted in.
model CampCheckIn {
  id        String   @id @default(cuid())
  checkInNo Int      @unique @default(autoincrement())
  createdAt DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  camp   Camp   @relation(fields: [campId], references: [id])
  campId String

  status       String    @default("CHECKED_IN") // "CHECKED_IN" | "BED_ALLOCATED" | "CHECKED_OUT"
  checkInDate  DateTime  @default(now())
  checkOutDate DateTime?

  bed   Bed?    @relation(fields: [bedId], references: [id])
  bedId String? @unique

  // Snapshot of Employee.branchId at creation, so branch-scoped queries don't
  // need to join through employeeId — same tradeoff Attachment makes.
  branchId String?

  @@index([employeeId])
  @@index([campId])
  @@index([status])
}

model Vehicle {
  id                 String    @id @default(cuid())
  plateNumber        String    @unique
  type               String? // e.g. "Bus", "Hiace Van", "Pickup"
  capacity           Int?
  driverName         String?
  driverPhone        String?
  registrationExpiry DateTime? // Mulkiya
  insuranceExpiry    DateTime?
  status             String    @default("ACTIVE") // "ACTIVE" | "MAINTENANCE" | "INACTIVE"
  notes              String?
  createdAt          DateTime  @default(now())

  employees Employee[]
  projects  VehicleProject[]
  routes    Route[]
}

// A named, recurring pickup route driven by a Vehicle — not branch-scoped,
// same deliberate deferral as Vehicle itself (see Phase 1 notes).
model Route {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  stops RouteStop[]
}

model RouteStop {
  id         String  @id @default(cuid())
  location   String
  stopOrder  Int
  pickupTime String? // free text, e.g. "07:30" — no date component, matches a recurring daily route
  notes      String?

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  @@index([routeId])
}

model VehicleProject {
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@id([vehicleId, projectId])
}

model Room {
  id             String  @id @default(cuid())
  name           String
  bedSpace       Int? // declared capacity — may exceed actual Bed rows if not all are registered yet
  usableBedSpace Int? // currently usable subset of bedSpace (e.g. some beds under maintenance)
  roomType       String? // LookupValue category ROOM_TYPE
  nationality    String? // targeting hint; matches Employee.nationality free-text country name

  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String
  beds   Bed[]

  @@unique([campId, name])
}

model Bed {
  id     String @id @default(cuid())
  label  String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  campCheckIn CampCheckIn?

  @@unique([roomId, label])
}

// Generic document store for entity types that don't have a dedicated
// *Document model (Supplier docs today; Payslips/Visa docs in later phases).
// entityId is not a database-enforced FK — Prisma has no polymorphic
// relations — so referential integrity on delete is app-code responsibility,
// the same tradeoff the Bytes-in-Postgres file storage already makes elsewhere.
model Attachment {
  id         String    @id @default(cuid())
  entityType String // "SUPPLIER" | "PAYSLIP" | "VISA" | ...
  entityId   String
  docType    String
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  // Copied from the owning entity at write time so dashboard queries can
  // filter by branch without joining through entityId.
  branchId String?

  // Office users upload as themselves; a supplier using the portal has no User
  // row, so its uploads carry the supplier id instead. Exactly one is set.
  uploadedBy           User?   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById         String?
  uploadedBySupplierId String?

  @@index([entityType, entityId])
  @@index([branchId, docType])
}

// Admin-configurable dropdown values replacing hand-typed free text on
// pseudo-enum fields (Employee.trade, .position, .bloodGroup, etc). category
// is one of the fixed keys in src/lib/lookupCategories.ts, not a DB-enforced
// enum — the category set itself is fixed by code, only the values within a
// category are admin-editable.
model LookupValue {
  id        String   @id @default(cuid())
  category  String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@unique([branchId, category, value])
  @@index([branchId, category])
}

// Change history for entity create/update/delete, written by logAudit()
// (src/lib/audit.ts). entityType/entityId are not DB-enforced FKs, same
// polymorphic tradeoff as Attachment above.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // "CREATE" | "UPDATE" | "DELETE"
  changes    Json? // UPDATE: { field: { from, to } } for changed fields only. CREATE/DELETE: full snapshot.
  userId     String
  userName   String // snapshot at write time
  branchId   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([branchId, createdAt])
}

// A staffing request a project raises for more workers, broken down into
// per-trade line items. Fulfilling a line item (see DemandRequestAllocation)
// is a real project placement, so it also opens an EmployeeAssignmentHistory
// row — this model exists alongside that so a line's fulfillment (quantity
// vs. allocated count) can be queried directly without re-deriving it.
model DemandRequest {
  id                   String   @id @default(cuid())
  requestNo            Int      @unique @default(autoincrement())
  requestType          String   @default("New") // "New" | "Replacement"
  status               String   @default("Open") // "Open" | "Approved" | "Rejected" | "Closed"
  priority             String? // "Low" | "Medium" | "High"
  salesExecutive       String? // defaults from Project.salesExecutive at creation, independently editable
  accommodationStatus  String?
  transportationStatus String?
  remarks              String?
  createdAt            DateTime @default(now())

  client    Client  @relation(fields: [clientId], references: [id])
  clientId  String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  branch    Branch  @relation(fields: [branchId], references: [id])
  branchId  String

  requestedBy   User?   @relation(fields: [requestedById], references: [id])
  requestedById String?

  trades         DemandRequestTrade[]
  nocs           Noc[]
  supplierOffers DemandSupplierOffer[]
}

model DemandRequestTrade {
  id       String  @id @default(cuid())
  // Kept as the display/legacy value. New rows also carry `skillId` below.
  trade    String
  quantity Int
  shift    String? // "Day" | "Night"
  rate     Float?

  // How many of `quantity` were actually agreed. Approval is per trade line,
  // not per request — a client may sign off on the masons and hold the
  // carpenters — and now per head within a line too: asking for ten and being
  // given six is the normal answer, and approving all ten was the only one the
  // system could record.
  //
  // null means nobody has decided yet; 0 means the line was refused. Kept
  // deliberately independent of whether idle workers of that trade exist —
  // mobilisation can re-designate someone from another trade, so a shortage
  // today shouldn't block approval.
  approvedQuantity Int?

  // The trade as an entry in the Trades taxonomy (the Skill table), so the
  // idle-worker count for a line is an exact join rather than a name match.
  // Nullable for rows created before the link existed.
  skill   Skill?  @relation(fields: [skillId], references: [id])
  skillId String?

  demandRequest   DemandRequest @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  demandRequestId String

  allocations DemandRequestAllocation[]
  offerLines  DemandOfferLine[]
}

model DemandRequestAllocation {
  id          String   @id @default(cuid())
  allocatedAt DateTime @default(now())

  demandRequestTrade   DemandRequestTrade @relation(fields: [demandRequestTradeId], references: [id], onDelete: Cascade)
  demandRequestTradeId String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}

// Admin-managed letter body — freeform text containing %%PLACEHOLDER%% merge
// fields, substituted at NOC-generation time. Category is a fixed short list,
// not a Lookup, since it defines the letter TYPE rather than open business data.
model LetterTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String? // "No Objection Letter" | "Mobilization Letter" | "Undertaking Letter" | "Supplier Undertaking"
  // Heading printed on the letter. Falls back to the category when empty.
  title       String?
  // Which built-in template this began as (src/lib/letterPresets.ts), so it can be reset to the original wording.
  presetKey   String?
  // Rich body from the editor (sanitised HTML). Null for older plain-text templates, which read from remarksText.
  bodyHtml    String?
  // SITE = client-facing letters with a worker table (NOC, undertaking...). EMPLOYEE = a letter about one employee.
  audience    String   @default("SITE")
  remarksText String
  createdAt   DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  nocs          Noc[]
  issuedLetters IssuedLetter[]
}

// A generated NOC/letter for a subset of a DemandRequest's allocated
// employees. PDF bytes are not stored — regenerated fresh on each download,
// matching how invoice generation already works.
model Noc {
  id            String    @id @default(cuid())
  docNo         Int       @unique @default(autoincrement())
  status        String    @default("Pending") // "Pending" | "Mobilization Complete"
  mobilizeDate  DateTime?
  remarks       String?
  displayFields String? // comma-separated Employee field keys, see src/lib/nocDisplayFields.ts
  createdAt     DateTime  @default(now())

  demandRequest   DemandRequest  @relation(fields: [demandRequestId], references: [id])
  demandRequestId String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  templateId      String
  branch          Branch         @relation(fields: [branchId], references: [id])
  branchId        String
  requestedBy     User?          @relation(fields: [requestedById], references: [id])
  requestedById   String?

  employees NocEmployee[]
}

model NocEmployee {
  id         String   @id @default(cuid())
  noc        Noc      @relation(fields: [nocId], references: [id], onDelete: Cascade)
  nocId      String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

// One in-app notification for one user. Email / WhatsApp copies are sent from
// the same call (src/lib/notifications/notify.ts) but aren't stored — this row
// is the inbox.
model Notification {
  id        String    @id @default(cuid())
  kind      String // e.g. "LEAVE_REQUESTED", "LEAVE_DECIDED", "EXPIRY_DIGEST"
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

// One month of payroll for a branch. DRAFT lines can be recomputed and
// adjusted; APPROVED locks the figures and unlocks the WPS file; PAID records
// that the bank has been instructed.
model PayrollRun {
  id         String    @id @default(cuid())
  month      String // "YYYY-MM"
  status     String    @default("DRAFT") // "DRAFT" | "APPROVED" | "PAID"
  notes      String?
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  // A draft is only "waiting for approval" once someone has sent it: the
  // approvals inbox lists submitted drafts, not ones still being edited.
  submittedAt   DateTime?
  submittedById String?
  returnNote    String? // why an approver sent it back to draft
  paidAt        DateTime?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  payerBank   Bank?   @relation(fields: [payerBankId], references: [id], onDelete: SetNull)
  payerBankId String?

  createdBy    User    @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdById  String
  approvedBy   User?   @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  approvedById String?

  lines  PayrollLine[]
  events PayrollRunEvent[]

  // One run per own company per month. Runs created before companies existed
  // have no company (they covered every own-company employee).
  company   Supplier? @relation("PayrollCompany", fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?
  payType   String? // snapshot of the company's pay type when the run was made

  @@unique([branchId, companyId, month])
}

// One employee's pay for a run. Pay and bank details are snapshotted at
// compute time so an approved run never shifts if the employee record changes.
model PayrollLine {
  id String @id @default(cuid())

  payStructure    String // snapshot: "ITEMISED" | "FLAT" | "HOURLY"
  daysInMonth     Int
  absentDays      Int    @default(0)
  unpaidLeaveDays Int    @default(0)
  normalHours     Float  @default(0)
  otHours         Float  @default(0)

  basic           Decimal @default(0) @db.Decimal(12, 2) // basic (itemised) or flat rate
  allowances      Decimal @default(0) @db.Decimal(12, 2)
  overtimePay     Decimal @default(0) @db.Decimal(12, 2)
  deductions      Decimal @default(0) @db.Decimal(12, 2) // absence + unpaid leave
  adjustment      Decimal @default(0) @db.Decimal(12, 2) // manual +/-
  adjustmentNote  String?
  otherEarnings   Decimal @default(0) @db.Decimal(12, 2) // recurring earnings (PayrollAdjustment)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2) // recurring deductions (PayrollAdjustment)
  // Typed in on the run. A deduction is a one-off amount taken off pay (a fine,
  // damage...); the advance is money already given that is recovered this
  // month. Each carries its own note. Both reduce net pay.
  manualDeduction Decimal @default(0) @db.Decimal(12, 2)
  deductionNote   String?
  advanceNote     String?
  advanceManual   Boolean @default(false) // true once someone has typed the advance, so a recalculation keeps it
  timesheetHours  Float   @default(0) // hours taken from the timesheet (hourly companies)
  loanDeduction   Decimal @default(0) @db.Decimal(12, 2) // instalments of active loans/advances
  // Where the worker was assigned when the run was calculated, so cost-by-project
  // stays true after they move. Plain id, not a relation: history outlives the project row.
  projectId       String?
  // Bank reconciliation once the WPS file has been sent.
  paymentStatus   String  @default("PENDING") // "PENDING" | "PAID" | "REJECTED" | "RESUBMIT"
  paymentNote     String?
  net             Decimal @default(0) @db.Decimal(12, 2)

  // Bank snapshot for the WPS file.
  paymentMode String?
  personCode  String?
  bankName    String?
  routingCode String?
  account     String?

  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String
  employee   Employee   @relation(fields: [employeeId], references: [id])
  employeeId String

  repayments LoanRepayment[]

  @@unique([runId, employeeId])
  @@index([runId, projectId])
}

// Sign-off trail for a run: who created, recalculated, approved, reopened and
// paid it, and when. Rows are only ever appended.
model PayrollRunEvent {
  id       String   @id @default(cuid())
  action   String // "CREATED" | "RECALCULATED" | "APPROVED" | "REOPENED" | "PAID"
  note     String?
  userId   String
  userName String
  at       DateTime @default(now())

  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  @@index([runId, at])
}

// Money advanced to an employee and recovered from pay in instalments. The
// remaining balance is principal - repaid; each recovery is a LoanRepayment
// written when the run that deducted it is approved.
model EmployeeLoan {
  id          String   @id @default(cuid())
  type        String // "LOAN" | "ADVANCE"
  principal   Decimal  @db.Decimal(12, 2)
  instalment  Decimal  @db.Decimal(12, 2) // recovered per pay run
  repaid      Decimal  @default(0) @db.Decimal(12, 2)
  startMonth  String // "YYYY-MM" — first run that may deduct it
  status      String   @default("ACTIVE") // "ACTIVE" | "CLEARED" | "CANCELLED"
  reason      String?
  createdAt   DateTime @default(now())
  createdById String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   String

  repayments LoanRepayment[]

  @@index([branchId, status])
  @@index([employeeId])
}

model LoanRepayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())

  loan   EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId String
  line   PayrollLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId String

  @@unique([loanId, lineId])
}

// A standing earning or deduction on one employee's pay — phone allowance,
// recurring fine, uniform recovery. Applies to every run from startMonth
// through endMonth (open-ended when null).
model PayrollAdjustment {
  id          String   @id @default(cuid())
  kind        String // "EARNING" | "DEDUCTION"
  label       String
  amount      Decimal  @db.Decimal(12, 2)
  startMonth  String // "YYYY-MM"
  endMonth    String? // inclusive; null = ongoing
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   String

  @@index([branchId, active])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Employee self-service sign-in
// ---------------------------------------------------------------------------

// One phone-number one-time-code attempt. The code itself is never stored, only
// an HMAC of it. Rows are throwaway; they double as the rate-limit ledger.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String // normalised, e.g. "+971501234567"
  codeHash   String
  ip         String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // Who the code was issued for: an employee (portal /me) or a supplier (/vendor).
  kind       String  @default("EMPLOYEE")
  employeeId String?
  supplierId String?

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// Finance: expenses and supplier bills (accounts payable)
// ---------------------------------------------------------------------------

// A cost the company incurred. Submitted by anyone with finance create rights,
// approved/rejected by an approver. `category` is free text with suggestions.
model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  category      String
  description   String
  amount        Decimal   @db.Decimal(12, 2)
  vatAmount     Decimal   @default(0) @db.Decimal(12, 2)
  paidTo        String?
  paymentMethod String? // "CASH" | "BANK" | "CARD" | "CHEQUE"
  reference     String?
  status        String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  // Paid by an employee from their own pocket and owed back to them.
  outOfPocket  Boolean   @default(false)
  reimbursedAt DateTime?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  submittedBy   User    @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  submittedById String
  decidedBy     User?   @relation("ExpenseDecidedBy", fields: [decidedById], references: [id])
  decidedById   String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([branchId, date])
  @@index([branchId, status])
}

// What a supplier has billed us. Status is derived from payments, never stored.
model SupplierBill {
  id          String   @id @default(cuid())
  billNo      String
  billDate    DateTime
  dueDate     DateTime
  amount      Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now())

  // Approval before payment. Bills that pre-date this default to APPROVED so
  // nothing already in the ledger suddenly stops being payable; new bills are
  // created PENDING by the action.
  approvalStatus      String    @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED"
  approvalNote        String?
  approvedAt          DateTime?
  approvedById        String?
  periodMonth         String? // "YYYY-MM" the bill covers, for comparing with timesheets
  // Submitted by the supplier through the portal rather than entered by our staff.
  submittedBySupplier Boolean   @default(false)

  // What the supplier's timesheet for periodMonth says we owe it, worked out
  // when the bill was entered (hours x rate, less absence and gas deductions).
  // A snapshot, so the comparison shown at approval time is the one that was
  // true when the bill arrived, even if the timesheet is edited afterwards.
  timesheetAmount Decimal? @db.Decimal(12, 2)
  timesheetHours  Float?

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  payments BillPayment[]

  @@unique([supplierId, billNo])
  @@index([branchId, dueDate])
}

model BillPayment {
  id        String   @id @default(cuid())
  paidOn    DateTime
  amount    Decimal  @db.Decimal(12, 2)
  method    String? // "BANK" | "CASH" | "CHEQUE"
  reference String?
  createdAt DateTime @default(now())

  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId String

  createdById String
}

// A letter about one employee, issued from a template (salary certificate,
// experience letter, warning...). The final wording is stored so it can be
// re-downloaded exactly as issued even if the template is edited later.
model IssuedLetter {
  id        String   @id @default(cuid())
  refNo     Int      @unique @default(autoincrement())
  title     String
  bodyHtml  String // fully substituted, sanitised
  inputs    Json? // what the person filled in for %%ASK:...%% prompts
  // How it was printed: { onLetterhead, signatoryName, signatoryTitle, showSignature, showStamp } — so a re-download matches the original.
  layout    Json?
  createdAt DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  template   LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  issuedBy   User   @relation(fields: [issuedById], references: [id])
  issuedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([employeeId, createdAt])
  @@index([branchId, createdAt])
}

// Monthly spending cap for one expense category in a branch. Approved spend is
// compared against it on the finance overview and when an expense is submitted.
model ExpenseBudget {
  id           String  @id @default(cuid())
  category     String
  monthlyLimit Decimal @db.Decimal(12, 2)

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@unique([branchId, category])
}

// Cash put into the petty-cash float. The balance is top-ups minus approved
// cash expenses, so nothing else has to be kept in step.
model PettyCashTopUp {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  createdById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([branchId, date])
}

// A demand sent to one supplier to answer through the portal. The supplier
// accepts (with a quote per trade line) or declines with a reason; nothing is
// allocated until our staff act on the answer.
model DemandSupplierOffer {
  id          String    @id @default(cuid())
  status      String    @default("SENT") // "SENT" | "ACCEPTED" | "DECLINED"
  note        String? // the supplier's cover note, or its reason for declining
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  sentById    String?

  demandRequest   DemandRequest @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  demandRequestId String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId      String

  lines DemandOfferLine[]

  @@unique([demandRequestId, supplierId])
  @@index([supplierId, status])
}

// The supplier's quote for one trade line of a demand: how many workers it
// offers and at what rate.
model DemandOfferLine {
  id       String   @id @default(cuid())
  quantity Int
  rate     Decimal? @db.Decimal(12, 2)

  offer                DemandSupplierOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId              String
  demandRequestTrade   DemandRequestTrade  @relation(fields: [demandRequestTradeId], references: [id], onDelete: Cascade)
  demandRequestTradeId String

  @@unique([offerId, demandRequestTradeId])
}

// A worker a supplier has added through the portal. It lives here, apart from
// Employee, until our staff approve it, so a pending worker never shows up in
// headcount, payroll, allocation or any list. Approval creates the Employee.
model WorkerSubmission {
  id          String    @id @default(cuid())
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  note        String? // reason when rejected
  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?
  employeeId  String? // the Employee created on approval

  firstName    String
  middleName   String?
  lastName     String
  gender       String? // "MALE" | "FEMALE"
  dateOfBirth  DateTime?
  nationality  String?
  mobileNumber String?
  trade        String
  joinDate     DateTime?
  bloodGroup   String?

  passportNumber   String
  emiratesId       String
  passportExpiry   DateTime?
  emiratesIdExpiry DateTime?
  visaExpiry       DateTime?
  laborCardExpiry  DateTime?
  medicalExpiry    DateTime?

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  branchId   String

  @@index([supplierId, status])
  @@index([branchId, status])
}

// Manpower a supplier says it can provide: a trade, a day and a head count.
model SupplierAvailability {
  id        String   @id @default(cuid())
  trade     String
  date      DateTime
  count     Int
  note      String?
  createdAt DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  branchId   String

  @@index([supplierId, date])
  @@index([branchId, date])
}

// A change a supplier asks to make to its own record (bank or contact details).
// Nothing is applied until our staff approve it: bank details decide where
// money goes, and the contact phone is also the portal sign-in number.
model SupplierChangeRequest {
  id          String    @id @default(cuid())
  kind        String // "BANK" | "CONTACT"
  payload     Json // the requested values, whitelisted per kind when applied
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  note        String? // reason when rejected
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  branchId   String

  @@index([supplierId, status])
  @@index([branchId, status])
}

// Feedback or a complaint a supplier sends from the portal. Staff answer in the
// office and the supplier reads the reply in its portal; the whole exchange is
// kept as a thread.
model SupplierTicket {
  id        String   @id @default(cuid())
  kind      String // "FEEDBACK" | "COMPLAINT"
  subject   String
  status    String   @default("OPEN") // "OPEN" | "REPLIED" | "CLOSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  branchId   String

  messages SupplierTicketMessage[]

  @@index([supplierId, updatedAt])
  @@index([branchId, status])
}

model SupplierTicketMessage {
  id           String   @id @default(cuid())
  fromSupplier Boolean
  authorName   String
  body         String
  createdAt    DateTime @default(now())

  ticket   SupplierTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@index([ticketId, createdAt])
}

// A supplier's in-portal inbox. Suppliers are not Users, so they cannot use the
// Notification table; this is its counterpart.
model SupplierNotification {
  id        String    @id @default(cuid())
  kind      String
  title     String
  body      String?
  href      String? // portal path to open, e.g. "/vendor/demands/abc"
  readAt    DateTime?
  createdAt DateTime  @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String

  @@index([supplierId, readAt, createdAt])
}

// A contact card shown to suppliers in their portal: who to call for what.
model PortalContact {
  id          String  @id @default(cuid())
  department  String // "Dubai", "Accounts", "Facilities"...
  personName  String
  designation String?
  phone       String?
  email       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([branchId, isActive, sortOrder])
}
