// Prisma schema for the Timesheet Platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // cross-branch; replaces the old global ADMIN
  BRANCH_ADMIN // full admin rights, scoped to one branch
  STAFF
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  emirate   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Company master-data fields (address/contact details of this operating entity).
  address  String?
  country  String?
  currency String?
  phone    String?
  email    String?
  // Letterhead details printed on generated timesheets and invoices.
  fax      String?
  poBox    String?
  trn      String? // Tax Registration Number

  users                User[]
  employees            Employee[]
  clients              Client[]
  suppliers            Supplier[]
  projects             Project[]
  uploads              Upload[]
  invoices             ClientInvoice[]
  sheets               GeneratedSheet[]
  items                InventoryItem[]
  entries              TimesheetEntry[]
  banks                Bank[]
  lookupValues         LookupValue[]
  demandRequests       DemandRequest[]
  letterTemplates      LetterTemplate[]
  nocs                 Noc[]
  lpos                 Lpo[]
  attendance           Attendance[]
  enquiries            Enquiry[]
  quotations           Quotation[]
}


// Company bank-account master, needed before Payroll/WPS can pay from a
// real account.
model Bank {
  id           String  @id @default(cuid())
  accountName  String
  bankName     String
  abbreviation String?
  accountNo    String?
  ibanNo       String?
  routingCode  String?
  swiftCode    String?
  bankBranch   String? // the bank's own branch name, not our Branch model
  address      String?
  remarks      String?
  status       String  @default("ACTIVE")

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  // SUPER_ADMIN is not tied to one branch, so this stays nullable.
  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  uploads          Upload[]
  generatedSheets  GeneratedSheet[]
  documents        Document[]
  clientInvoices   ClientInvoice[]
  clientDocuments  ClientDocument[]
  projectDocuments ProjectDocument[]
  attachments      Attachment[]
  demandRequests   DemandRequest[]
  nocs             Noc[]
  employeeNotes EmployeeNote[]
}

// One row per file import (a whole workbook, which may contain multiple month tabs).
model Upload {
  id           String   @id @default(cuid())
  filename     String
  fileData     Bytes?
  uploadedAt   DateTime @default(now())
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  months UploadMonth[]
}

// One row per month tab processed within an upload (e.g. "MAY-25").
model UploadMonth {
  id          String   @id @default(cuid())
  month       String // normalized key, e.g. "2025-05"
  monthLabel  String // as it appeared in the sheet, e.g. "MAY-25"
  sheetName   String
  rowCount    Int      @default(0)
  processedAt DateTime @default(now())

  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String

  @@index([month])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  fullName  String? // formal letterhead name, e.g. "BURJ AL AWEER CONCRETE CARPENTER CONT."
  createdAt DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  mohrePermitNumber   String? // MOHRE manpower supply approval/permit number
  tradeLicenseNumber  String?
  tradeLicenseExpiry  DateTime?
  contactPerson       String?
  contactPhone        String?
  contactEmail        String?
  bankName            String?
  iban                String?
  paymentTerms        String? // e.g. "Net 30"
  status              String    @default("ACTIVE") // "ACTIVE" | "BLACKLISTED"
  payoutCycleStartDay Int       @default(1) // day of month the payout cycle starts; 1 = calendar month

  category            String?
  previousId          String?
  allowManualLabourId Boolean @default(false)
  overtime            Boolean @default(false)
  supplierAmountLimit Float? // credit limit
  pointOfContact      String?
  country             String?
  emirate             String?
  account             String? // accounting reference only, no ledger integration
  bankAccountName     String?
  bankAccountNumber   String?
  bankCompany         String? // beneficiary company name on the bank account
  bankEmirate         String?

  trn        String? // Tax Registration Number
  activeFrom DateTime?
  poBox      String?
  location   String?
  phone      String? // secondary phone, distinct from contactPhone (mobile)

  approvalStatus        String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates attaching labour to a project
  labourApprovalStatus  String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates allocating labour to a Demand Request
  invoiceApprovalStatus String @default("Pending") // "Pending" | "Approved" | "Rejected" — gates generating the supplier payout sheet

  // Our own entities vs third-party subcontractors. Same shape, but the
  // distinction drives whose letterhead a document is issued on and who is
  // being billed rather than paid.
  isOwnCompany     Boolean    @default(false)

  sponsoredEmployees Employee[] @relation("EmployeeSponsor")

  parent           Supplier?  @relation("SupplierSubsidiaries", fields: [parentSupplierId], references: [id])
  parentSupplierId String?
  subsidiaries     Supplier[] @relation("SupplierSubsidiaries")

  entries         TimesheetEntry[]
  generatedSheets GeneratedSheet[]
  employees       Employee[]
  attendance      Attendance[]
}

model Client {
  id            String    @id @default(cuid())
  name          String    @unique
  code          String?   @unique
  branch        Branch    @relation(fields: [branchId], references: [id])
  branchId      String
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  basicRate     Float?
  hourlyRate    Float?
  contractStart DateTime?
  contractEnd   DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  trn                String? // Tax Registration Number
  tradeLicenseNumber String?
  tradeLicenseExpiry DateTime?
  billingAddress     String?
  paymentTerms       String? // e.g. "Net 30"
  retentionPercent   Float?
  secondContactName  String? // accounts payable contact, if different
  secondContactPhone String?
  secondContactEmail String?

  country         String?
  emirate         String?
  website         String?
  fax             String?
  poBox           String?
  paymentSchedule String?
  account         String? // accounting reference only, no ledger integration
  vendorCode      String?

  customer  String? // parent/umbrella account, if applicable
  currency  String? @default("AED")
  grades    String?
  telephone String? // landline, distinct from contactPhone (mobile)

  entries        TimesheetEntry[]
  projects       Project[]
  contacts       ClientContact[]
  invoices       ClientInvoice[]
  tradeRates     ClientTradeRate[]
  documents      ClientDocument[]
  demandRequests DemandRequest[]
  lpos           Lpo[]
  enquiries      Enquiry[]
  quotations     Quotation[]
}

// Per-trade billing rate for a client, e.g. Carpenter AED 45/hr, Helper AED 35/hr.
// Falls back to Client.hourlyRate/basicRate when a trade has no rate set here.
// A row with projectId set overrides the client-wide row for that trade on that project.
model ClientTradeRate {
  id    String @id @default(cuid())
  trade String
  rate  Float

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  @@unique([clientId, projectId, trade])
}

model ClientDocument {
  id         String    @id @default(cuid())
  type       String // "TRADE_LICENSE" | "TRN_CERTIFICATE" | "CONTRACT" | "OTHER"
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

// A record of each generated client invoice (for history / re-download / AR tracking).
model ClientInvoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  month         String
  monthLabel    String
  subtotal      Float
  vatAmount     Float
  totalAmount   Float
  status        String    @default("DRAFT") // "DRAFT" | "SENT" | "PAID" | "OVERDUE"
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  paidDate      DateTime?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  generatedBy   User   @relation(fields: [generatedById], references: [id])
  generatedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([month, clientId])
}

model ClientContact {
  id          String  @id @default(cuid())
  name        String
  designation String?
  phone       String?
  email       String?

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
}

// One row per employee, per month, per supplier — upserted on re-upload so
// daily uploads simply refresh the running month's data.
model TimesheetEntry {
  id              String   @id @default(cuid())
  month           String // "2025-05"
  monthLabel      String // "MAY-25"
  employeeIdNo    String // e.g. "BACC123"
  employeeName    String
  trade           String
  rate            Float
  site            String?
  dailyHours      String // JSON: [{ "date": "2025-05-01", "label": "Thu", "value": "10" | "A" | "OFF" }, ...]
  totalHours      Float    @default(0)
  absentCount     Int      @default(0)
  absentDeduction Float    @default(0) // editable before export
  invoiceValue    Float    @default(0) // rate * totalHours, as in source sheet
  status          String   @default("DRAFT") // "DRAFT" | "SUBMITTED" | "UNDER_REVIEW" | "CLIENT_APPROVED" | "REJECTED" | "LOCKED"
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  // Denormalized directly rather than derived through supplier/client, since
  // this is the highest-volume table and list queries need a join-free filter.
  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  // Set only via manual entry today; Excel-upload entries have no project info
  // and fall back to the client-level billing rate when generating invoices.
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // `site` (above) is the legacy free-text column, still populated by Excel
  // imports independently — this FK is the new optional link to a real Site
  // record, set only by Daily Timesheet / Manual Entry when one is picked.
  siteRecord Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId     String?

  @@unique([month, supplierId, employeeIdNo, trade])
  @@index([month, supplierId])
  @@index([branchId])
}

// A record of each generated company timesheet (for history / re-download).
model GeneratedSheet {
  id           String   @id @default(cuid())
  month        String
  monthLabel   String
  format       String // "xlsx" | "pdf"
  gasDeduction Float    @default(0)
  issuedTo     String
  generatedAt  DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  generatedBy   User   @relation(fields: [generatedById], references: [id])
  generatedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([month, supplierId])
}

model Settings {
  id         String  @id @default("singleton")
  issuedTo   String  @default("Kenz Al Turath Technical Services")
  companyTrn String? // this company's own Tax Registration Number, printed on client invoices
}

enum EmployeeStatus {
  // On the books, not working.
  IDLE
  // Allocated to a demand on paper, but nobody has confirmed they turned up.
  UNDER_MOBILISATION
  // Someone has confirmed the worker physically reached site. Distinct from
  // ACTIVE because arrival is a fact a supervisor asserts on the day, while
  // attendance is only entered later — often days later, sometimes never.
  ON_SITE
  // Working: attendance has been marked at least once since mobilising.
  ACTIVE
  ON_VACATION
  TERMINATED
}

enum EmployeeCategory {
  STAFF // office/corporate roster
  SITE_STAFF // field/manpower roster
}

// Employee master record — auto-created/refreshed from uploads (name, trade,
// supplier) and manually enriched here (photo, compliance dates, etc). The
// upload flow never touches the manually-owned fields.
model Employee {
  id               String           @id @default(cuid())
  employeeIdNo     String           @unique
  name             String
  trade            String?
  // Kept alongside the legacy `active` boolean during the transition — existing
  // dashboard/list queries still read `active`; new code should prefer `status`.
  status           EmployeeStatus   @default(ACTIVE)
  category         EmployeeCategory @default(SITE_STAFF)
  photoData        Bytes?
  photoMimeType    String?
  nationality      String?
  position         String?
  passportNumber   String?
  emiratesId       String?
  emiratesIdExpiry DateTime?
  visaExpiry       DateTime?
  laborCardExpiry  DateTime?
  medicalExpiry    DateTime?
  passportExpiry   DateTime?
  salaryType       String? // "BASIC" | "HOURLY" — reference only
  salaryRate       Float? // reference only, pairs with salaryType
  notes            String?

  dateOfBirth           DateTime?
  gender                String? // "MALE" | "FEMALE"
  bloodGroup            String?
  mobileNumber          String?
  whatsappNumber        String?
  joinDate              DateTime?
  laborCardNumber       String?
  sponsorName           String? // visa-holding entity, if different from supplier
  emergencyContactName  String?
  emergencyContactPhone String?
  wpsBankName           String? // Wage Protection System bank / exchange house
  wpsIban               String?
  wpsPaymentMode        String?
  wpsRoutingCode        String?
  wpsAccountHolderName  String?
  wpsAccountNumber      String?

  // Visa (visaExpiry above is the terminal expiry date already tracked)
  // ICP unified number — stable across visa renewals, unlike the file number.
  unifiedNo        String?
  visaNumber       String?
  visaType         String?
  visaStatus       String?
  visaDesignation  String?
  visaStampingDate DateTime?
  molPersonCode    String?

  // Passport (passportNumber/passportExpiry above already exist)
  passportStatus      String?
  passportReleaseDate DateTime?
  passportReturnDate  DateTime?

  // Labour Card (laborCardNumber/laborCardExpiry above already exist)
  laborCardPersonalNo String?
  laborCardStatus     String?

  // CICPA — Abu Dhabi critical-infrastructure/coastal-protection site clearance
  cicpaNumber    String?
  cicpaIssueDate DateTime?
  cicpaExpiry    DateTime?
  cicpaStatus    String?
  cicpaLocation  String?

  // Insurance
  insuranceCardType        String?
  insuranceCardNumber      String?
  insuranceIssueDate       DateTime?
  insuranceExpiry          DateTime?
  insuranceStatus          String?
  insuranceServiceProvider String?

  // Driving Licence
  drivingLicenceNumber    String?
  drivingLicenceIssueDate DateTime?
  drivingLicenceExpiry    DateTime?
  drivingLicenceType      String?
  drivingLicenceStatus    String?

  // Medical (medicalExpiry above already exists)
  medicalStatus String?
  eidStatus     String?

  active              Boolean   @default(true)
  inactiveReason      String?
  lastDemobilizedDate DateTime?
  // The date the worker is due on site, chosen when mobilising. Distinct from
  // the assignment's created date, which is when the paperwork was done.
  mobilisationDate    DateTime?
  // The date the worker was confirmed to have actually reached site. Null while
  // they are still only mobilised on paper; the gap between the two dates is
  // how late a mobilisation ran.
  siteArrivalDate     DateTime?
  religion            String?
  state               String? // state/province within nationality country
  accommodationType   String?
  previousId          String?
  nameInIdCard        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  // The company holding the visa. Often, but not always, the employer, so it
  // stays a separate link — it just points at Supplier now rather than a
  // duplicate SponsorshipCompany list.
  sponsorSupplier   Supplier? @relation("EmployeeSponsor", fields: [sponsorSupplierId], references: [id])
  sponsorSupplierId String?

  documents              Document[]
  skills                 EmployeeSkill[]
  vaccinations           EmployeeVaccination[]
  visaApplications       VisaApplication[]
  labourCardApplications LabourCardApplication[]
  noteEntries            EmployeeNote[]
  assignmentHistory      EmployeeAssignmentHistory[]
  accommodationHistory   AccommodationHistory[]
  demandRequestAllocations DemandRequestAllocation[]
  nocEmployees           NocEmployee[]
  bed                    Bed?
  attendance             Attendance[]
}

// System-written record of each project placement — opened/closed
// automatically by updateEmployeeAction when Employee.projectId changes.
// Employee.projectId remains the live pointer; this is the audit trail of
// past placements, since there's no other way to know when someone was
// mobilized/demobilized to a given project.
// A dated note about a worker with its own attachments — prior employment,
// a warning, a site incident, anything worth keeping on file. Repeatable, so
// the record builds up over time instead of one field being overwritten.
model EmployeeNote {
  id        String   @id @default(cuid())
  remarks   String
  createdAt DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  documents Document[]

  @@index([employeeId, createdAt])
}

model EmployeeAssignmentHistory {
  id              String    @id @default(cuid())
  branchName      String? // snapshot; branchId isn't the change trigger here
  projectId       String?
  projectName     String? // snapshot — stays readable if the Project is later renamed/deleted
  mobilizedDate   DateTime  @default(now())
  demobilizedDate DateTime?
  createdAt       DateTime  @default(now())

  // Why the placement ended, and who ended it. This row is already the record
  // of the placement, so the reason belongs on it rather than only in the audit
  // log — the demobilisation list reads it back.
  demobilizationReason String?
  demobilizedByName    String? // snapshot, like branchName/projectName above

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@index([employeeId])
  @@index([demobilizedDate])
}

// System-written record of each bed placement — opened/closed automatically
// by assignBedAction/unassignBedAction. Bed.employeeId remains the live
// pointer; this is the audit trail, using string snapshots (not FKs) so
// history stays readable even after a bed/room/camp is later deleted.
model AccommodationHistory {
  id           String    @id @default(cuid())
  campName     String?
  roomName     String?
  bedLabel     String?
  checkInDate  DateTime  @default(now())
  checkOutDate DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@index([employeeId])
}

// Stage-tracking history for a visa cycle (submitted -> medical -> stamped ->
// cancelled -> re-issued, etc). Employee.visaNumber/visaStatus/visaExpiry
// remain the compliance/dashboard source of truth (the current snapshot);
// this is a pure audit trail of how that snapshot got there over time.
model VisaApplication {
  id        String    @id @default(cuid())
  stage     String // LookupValue category VISA_APPLICATION_STAGE
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
}

// Same shape as VisaApplication, for labour card stage history.
model LabourCardApplication {
  id        String    @id @default(cuid())
  stage     String // LookupValue category LABOUR_CARD_APPLICATION_STAGE
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
}

// Repeatable vaccination record per employee (from the competitor's Medical
// Details tab).
model EmployeeVaccination {
  id          String    @id @default(cuid())
  vaccineName String
  doseNumber  Int?
  date        DateTime?
  expiryDate  DateTime?
  notes       String?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
}

model Document {
  id           String    @id @default(cuid())
  type         String // "PASSPORT" | "VISA" | "LABOR_CARD" | "MEDICAL" | "EMIRATES_ID" | "CICPA" | "INSURANCE" | "DRIVING_LICENCE" | "OTHER"
  status       String    @default("ACTIVE")
  displayInEss Boolean   @default(false)
  filename     String
  fileData     Bytes
  mimeType     String
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
  // Set when the file was attached to a note rather than filed on its own.
  note   EmployeeNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?

  visaApplications       VisaApplication[]
  labourCardApplications LabourCardApplication[]
}

model Project {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  description   String?
  manager       String?
  timelineStart DateTime?
  timelineEnd   DateTime?
  status        String    @default("PLANNING") // "PLANNING" | "ACTIVE" | "COMPLETED" | "ON_HOLD"
  createdAt     DateTime  @default(now())

  clientProjectNo         String? // client's own reference/PO number
  jobType                 String?
  mainContractor          String?
  paymentType             String?
  sponsorshipCompany      String?
  salesExecutive          String?
  projectCoordinator      String?
  contactNo               String?
  timesheetCollectionDate DateTime?
  noOfEmployeesRequired   Int?
  dayShiftStart           String? // "HH:MM"
  dayShiftEnd             String?
  nightShiftStart         String?
  nightShiftEnd           String?
  interTransfer           Boolean   @default(false)
  internalUse             Boolean   @default(false)

  address   String? // free-text location detail
  latitude  Float?
  longitude Float?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  employees        Employee[]
  vehicles         VehicleProject[]
  timesheetEntries TimesheetEntry[]
  tradeRates       ClientTradeRate[]
  documents        ProjectDocument[]
  holidays         ProjectHoliday[]
  contacts         ProjectContact[]
  inventory        ProjectInventoryAssignment[]
  demandRequests   DemandRequest[]
  routes           Route[]
  sites            Site[]
  lpos             Lpo[]
  attendance       Attendance[]
  quotations       Quotation[]
}

// A Local Purchase Order — the client's authorization + funding envelope for
// a Project. A Project can have more than one Lpo over its lifetime (renewal
// / amendment); only one is normally ACTIVE at a time, tracked via status
// rather than enforced by the schema (matches this codebase's convention of
// plain-string statuses with no state-machine helper). billedAmount is a
// manually-tracked running total, not derived from ClientInvoice, because
// ClientInvoice is client+month scoped today with no project/LPO linkage.
model Lpo {
  id           String    @id @default(cuid())
  lpoNumber    String    @unique
  value        Float?
  quantity     Int?
  trade        String?
  rate         Float?
  validFrom    DateTime?
  validTo      DateTime?
  status       String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CLOSED"
  billedAmount Float     @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([branchId, projectId])
}

// Daily attendance, distinct from the monthly TimesheetEntry hours grid —
// one row per employee per calendar day. Once approved (locked=true),
// direct edits are rejected and any change must go through
// AttendanceCorrectionRequest instead. Deliberately not wired into
// TimesheetEntry.dailyHours yet — that JSON pipeline has too many existing
// consumers (Excel import, xlsx/pdf export, gas-deduction calc) to safely
// rewire in this pass; a later phase can add a reconcile step once this
// module has run in production long enough to trust its data.
model Attendance {
  id           String    @id @default(cuid())
  date         DateTime
  status       String    @default("PRESENT") // "PRESENT" | "ABSENT" | "LEAVE" | "HOLIDAY" | "OFF"
  normalHours  Float?
  otHours      Float?
  locked       Boolean   @default(false)
  markedById   String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  corrections AttendanceCorrectionRequest[]

  @@unique([employeeId, date])
  @@index([branchId, date])
  @@index([projectId, date])
}

model AttendanceCorrectionRequest {
  id                   String    @id @default(cuid())
  requestedStatus      String?
  requestedNormalHours Float?
  requestedOtHours     Float?
  reason               String?
  status               String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  requestedById        String
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId String
}

// Pre-sales pipeline: Client Enquiry/RFQ, ahead of a Quotation. No Project
// exists yet at this stage (projectHint is free text only).
model Enquiry {
  id            String   @id @default(cuid())
  enquiryNo     Int      @unique @default(autoincrement())
  projectHint   String?
  requiredTrade String?
  source        String?
  remarks       String?
  status        String   @default("Open") // "Open" | "Quoted" | "Lost" | "Converted"
  createdAt     DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  requestedById String?

  quotations Quotation[]
}

// A formal quotation with trade/quantity/rate line items, moving through
// negotiation/approval stages before conversion into a real Project (and
// optionally an Lpo, if Phase A's Lpo model is populated at conversion
// time). Mirrors the DemandRequest/DemandRequestTrade header+line shape.
model Quotation {
  id               String    @id @default(cuid())
  quotationNumber  String    @unique
  status           String    @default("DRAFT") // "DRAFT" | "SENT" | "NEGOTIATION" | "APPROVED" | "ACCEPTED" | "REJECTED" | "CONVERTED"
  validUntil       DateTime?
  terms            String?
  accommodationResponsibility  String?
  transportationResponsibility String?
  ppeResponsibility            String?
  createdAt        DateTime  @default(now())

  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id])
  enquiryId String?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String? // set once converted

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  createdById String

  lines QuotationLine[]
}

model QuotationLine {
  id           String  @id @default(cuid())
  trade        String
  quantity     Int
  rate         Float
  otRate       Float?
  nationality  String?
  workingHours String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
}

// A physical location under a Project — one Project can have multiple Sites
// (e.g. separate buildings/plots on one job). Deliberately a child of
// Project, not a standalone concept (the earlier flat, unrelated Site model
// was removed for exactly that reason).
model Site {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  employees        Employee[]
  timesheetEntries TimesheetEntry[]
}

model ProjectDocument {
  id         String    @id @default(cuid())
  type       String // "CONTRACT" | "LPO" | "PERMIT" | "OTHER"
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

model ProjectHoliday {
  id             String   @id @default(cuid())
  date           DateTime
  label          String
  rateMultiplier Float? // e.g. 1.5 for 1.5x pay on this date

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([projectId, date])
}

// Free-text roster of people tied to a project (not a login/User account).
model ProjectContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  phone String?
  email String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model InventoryItem {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
  notes    String?

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  assignments ProjectInventoryAssignment[]
}

model ProjectInventoryAssignment {
  id           String    @id @default(cuid())
  quantity     Int       @default(1)
  assignedDate DateTime  @default(now())
  returnDate   DateTime?
  condition    String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  item   InventoryItem @relation(fields: [itemId], references: [id])
  itemId String
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  // Short mnemonic (HLP, MSN, SFX) printed on timesheets and letters, where a
  // full trade name doesn't fit a column.
  code     String? @unique
  category String?
  trending Boolean @default(false)

  employees EmployeeSkill[]
  demandTrades DemandRequestTrade[]
}

model EmployeeSkill {
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String

  // "Known Trade Details" — proficiency and a trade-specific pay rate.
  proficiencyPercent Int?
  rate               Float?
  // "HOURLY" | "FIXED" — how `rate` is applied for this trade.
  rateType           String?
  // The trade the worker is currently deployed as. A worker can hold several
  // trades but works one at a time, and it's the active one that a demand
  // matches against and that the timesheet bills.
  isActive           Boolean @default(false)

  @@id([employeeId, skillId])
}

model Camp {
  id    String @id @default(cuid())
  name  String @unique
  rooms Room[]
}

model Vehicle {
  id                 String    @id @default(cuid())
  plateNumber        String    @unique
  type               String? // e.g. "Bus", "Hiace Van", "Pickup"
  capacity           Int?
  driverName         String?
  driverPhone        String?
  registrationExpiry DateTime? // Mulkiya
  insuranceExpiry    DateTime?
  status             String    @default("ACTIVE") // "ACTIVE" | "MAINTENANCE" | "INACTIVE"
  notes              String?
  createdAt          DateTime  @default(now())

  employees Employee[]
  projects  VehicleProject[]
  routes    Route[]
}

// A named, recurring pickup route driven by a Vehicle — not branch-scoped,
// same deliberate deferral as Vehicle itself (see Phase 1 notes).
model Route {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  stops RouteStop[]
}

model RouteStop {
  id         String  @id @default(cuid())
  location   String
  stopOrder  Int
  pickupTime String? // free text, e.g. "07:30" — no date component, matches a recurring daily route
  notes      String?

  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  @@index([routeId])
}

model VehicleProject {
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@id([vehicleId, projectId])
}

model Room {
  id             String  @id @default(cuid())
  name           String
  bedSpace       Int? // declared capacity — may exceed actual Bed rows if not all are registered yet
  usableBedSpace Int? // currently usable subset of bedSpace (e.g. some beds under maintenance)
  roomType       String? // LookupValue category ROOM_TYPE
  nationality    String? // targeting hint; matches Employee.nationality free-text country name

  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade)
  campId String
  beds   Bed[]

  @@unique([campId, name])
}

model Bed {
  id     String @id @default(cuid())
  label  String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  @@unique([roomId, label])
}

// Generic document store for entity types that don't have a dedicated
// *Document model (Supplier docs today; Payslips/Visa docs in later phases).
// entityId is not a database-enforced FK — Prisma has no polymorphic
// relations — so referential integrity on delete is app-code responsibility,
// the same tradeoff the Bytes-in-Postgres file storage already makes elsewhere.
model Attachment {
  id         String    @id @default(cuid())
  entityType String // "SUPPLIER" | "PAYSLIP" | "VISA" | ...
  entityId   String
  docType    String
  filename   String
  fileData   Bytes
  mimeType   String
  expiryDate DateTime?
  uploadedAt DateTime  @default(now())

  // Copied from the owning entity at write time so dashboard queries can
  // filter by branch without joining through entityId.
  branchId String?

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@index([entityType, entityId])
  @@index([branchId, docType])
}

// Admin-configurable dropdown values replacing hand-typed free text on
// pseudo-enum fields (Employee.trade, .position, .bloodGroup, etc). category
// is one of the fixed keys in src/lib/lookupCategories.ts, not a DB-enforced
// enum — the category set itself is fixed by code, only the values within a
// category are admin-editable.
model LookupValue {
  id        String   @id @default(cuid())
  category  String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@unique([branchId, category, value])
  @@index([branchId, category])
}

// Change history for entity create/update/delete, written by logAudit()
// (src/lib/audit.ts). entityType/entityId are not DB-enforced FKs, same
// polymorphic tradeoff as Attachment above.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // "CREATE" | "UPDATE" | "DELETE"
  changes    Json? // UPDATE: { field: { from, to } } for changed fields only. CREATE/DELETE: full snapshot.
  userId     String
  userName   String // snapshot at write time
  branchId   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([branchId, createdAt])
}

// A staffing request a project raises for more workers, broken down into
// per-trade line items. Fulfilling a line item (see DemandRequestAllocation)
// is a real project placement, so it also opens an EmployeeAssignmentHistory
// row — this model exists alongside that so a line's fulfillment (quantity
// vs. allocated count) can be queried directly without re-deriving it.
model DemandRequest {
  id                   String   @id @default(cuid())
  requestNo            Int      @unique @default(autoincrement())
  requestType          String   @default("New") // "New" | "Replacement"
  status               String   @default("Open") // "Open" | "Approved" | "Rejected" | "Closed"
  priority             String? // "Low" | "Medium" | "High"
  salesExecutive       String? // defaults from Project.salesExecutive at creation, independently editable
  accommodationStatus  String?
  transportationStatus String?
  remarks              String?
  createdAt            DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id])
  clientId  String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  branch    Branch @relation(fields: [branchId], references: [id])
  branchId  String

  requestedBy   User?   @relation(fields: [requestedById], references: [id])
  requestedById String?

  trades DemandRequestTrade[]
  nocs   Noc[]
}

model DemandRequestTrade {
  id       String  @id @default(cuid())
  // Kept as the display/legacy value. New rows also carry `skillId` below.
  trade    String
  quantity Int
  shift    String? // "Day" | "Night"
  rate     Float?

  // Approval is per trade line, not per request: a client may sign off on the
  // masons and hold the carpenters. Deliberately independent of whether idle
  // workers of that trade exist — mobilisation can re-designate someone from
  // another trade, so a shortage today shouldn't block approval.
  approved Boolean @default(false)

  // The trade as an entry in the Trades taxonomy (the Skill table), so the
  // idle-worker count for a line is an exact join rather than a name match.
  // Nullable for rows created before the link existed.
  skill   Skill?  @relation(fields: [skillId], references: [id])
  skillId String?

  demandRequest   DemandRequest @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  demandRequestId String

  allocations DemandRequestAllocation[]
}

model DemandRequestAllocation {
  id          String   @id @default(cuid())
  allocatedAt DateTime @default(now())

  demandRequestTrade   DemandRequestTrade @relation(fields: [demandRequestTradeId], references: [id], onDelete: Cascade)
  demandRequestTradeId String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}

// Admin-managed letter body — freeform text containing %%PLACEHOLDER%% merge
// fields, substituted at NOC-generation time. Category is a fixed short list,
// not a Lookup, since it defines the letter TYPE rather than open business data.
model LetterTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String? // "No Objection Letter" | "Mobilization Letter" | "Undertaking Letter" | "Supplier Undertaking"
  remarksText String
  createdAt   DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  nocs Noc[]
}

// A generated NOC/letter for a subset of a DemandRequest's allocated
// employees. PDF bytes are not stored — regenerated fresh on each download,
// matching how invoice generation already works.
model Noc {
  id            String    @id @default(cuid())
  docNo         Int       @unique @default(autoincrement())
  status        String    @default("Pending") // "Pending" | "Mobilization Complete"
  mobilizeDate  DateTime?
  remarks       String?
  displayFields String? // comma-separated Employee field keys, see src/lib/nocDisplayFields.ts
  createdAt     DateTime  @default(now())

  demandRequest   DemandRequest  @relation(fields: [demandRequestId], references: [id])
  demandRequestId String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  templateId      String
  branch          Branch         @relation(fields: [branchId], references: [id])
  branchId        String
  requestedBy     User?          @relation(fields: [requestedById], references: [id])
  requestedById   String?

  employees NocEmployee[]
}

model NocEmployee {
  id         String   @id @default(cuid())
  noc        Noc      @relation(fields: [nocId], references: [id], onDelete: Cascade)
  nocId      String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}
